# Copiez ce fichier vers .env à la racine du projet avant « docker compose up --build »

# OBLIGATOIRE : au moins 32 caractères aléatoires (le serveur refuse de démarrer sinon). Générer :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=remplacez_par_une_longue_phrase_secrete_unique

# Adresse publique du site, sans « / » final (en local : http://localhost:8080)
CLIENT_URL=http://localhost:8080
API_URL=http://localhost:8080

# 1 : nginx seul devant le serveur ; 2 : Caddy / Cloudflare devant nginx
TRUST_PROXY=1

# Facultatif : adresse du compte qui devient « administrateur du projet » si aucun n'existe
# OWNER_EMAIL=moi@exemple.com

# Facultatif : connexion Google / Facebook / GitHub (voir README)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
